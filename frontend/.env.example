# Backend API root (production: https://api.yourdomain.uz/api)
VITE_API_URL=http://127.0.0.1:8000/api
# Media host (production: https://api.yourdomain.uz)
VITE_MEDIA_URL=http://127.0.0.1:8000
# Google Sign-In OAuth client ID (same as backend GOOGLE_CLIENT_ID).
# Empty value hides the Google button on login/register pages.
VITE_GOOGLE_CLIENT_ID=
